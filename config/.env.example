# KARGU-OSINT API keys — keep this file private (chmod 600, git-ignored)
# Any key left empty simply disables that source; the scan still runs.

# numverify (apilayer) — phone validation: country, carrier, line type
NUMVERIFY_API_KEY=

# VirusTotal v3 — domain reputation, DNS records, subdomains, historic IPs
VIRUSTOTAL_API_KEY=

# ProjectDiscovery Chaos — subdomain dataset (public bug-bounty scopes only)
CHAOS_API_KEY=

# Hunter.io — corporate e-mail discovery + verification.
# Signup requires a WORK e-mail (free providers such as gmail are rejected).
# See README section "Getting a Hunter.io key" for how to obtain one.
HUNTER_API_KEY=

# Have I Been Pwned v3 — breach lookup per e-mail (paid, ~$4/month)
HIBP_API_KEY=

# --- fusion dashboard feeds (all optional; a missing key just turns that panel off) ---
# Telegram (my.telegram.org) — search public channels from the dashboard, or run the
# background listener. Use a throwaway account; the session file grants full account access.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# comma-separated public channels for the listener and for scoped search (empty = global search)
TELEGRAM_CHANNELS=

# Copernicus Data Space (dataspace.copernicus.eu, free) — Sentinel-2 quicklooks around a pin
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
