# KARGU-OSINT API keys — keep this file private (chmod 600, git-ignored)
# Any key left empty simply disables that source; the scan still runs.

# numverify (apilayer) — phone validation: country, carrier, line type
NUMVERIFY_API_KEY=

# VirusTotal v3 — domain reputation, DNS records, subdomains, historic IPs
VIRUSTOTAL_API_KEY=

# ProjectDiscovery Chaos — subdomain dataset (public bug-bounty scopes only)
CHAOS_API_KEY=

# Hunter.io — corporate e-mail discovery + verification.
# Signup requires a WORK e-mail (free providers such as gmail are rejected).
# See README section "Getting a Hunter.io key" for how to obtain one.
HUNTER_API_KEY=

# Have I Been Pwned v3 — breach lookup per e-mail (paid, ~$4/month)
HIBP_API_KEY=
